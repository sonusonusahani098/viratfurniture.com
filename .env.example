# Copy to .env and fill in real values. Never commit .env.

# Password for the /admin gallery upload page
NUXT_ADMIN_PASSWORD=

# Cloudinary credentials (Dashboard → Settings → API Keys)
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
# Folder inside Cloudinary where gallery images are stored
NUXT_CLOUDINARY_FOLDER=virat-furniture/gallery

# Must match NUXT_CLOUDINARY_CLOUD_NAME — used by the browser to build image URLs
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Secret used to sign OG image URLs in production
NUXT_OG_IMAGE_SECRET=
